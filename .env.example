# PostgreSQL database connection URL (or local SQLite file:./dev.db in development)
DATABASE_URL=""
# Direct PostgreSQL connection URL for Prisma migrations on Supabase (port 5432)
DIRECT_URL=""
# Server-side Razorpay API Key ID (test key in dev, live key in production)
RAZORPAY_KEY_ID=""
# Server-side Razorpay API Key Secret for creating orders and verifying payments
RAZORPAY_KEY_SECRET=""
# Webhook secret configured in Razorpay Dashboard to sign webhook payloads
RAZORPAY_WEBHOOK_SECRET=""
# Client-side public Razorpay Key ID for initializing Standard Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Owner-chosen admin passphrase (minimum 20 characters, configured via npm run admin:set-key)
ADMIN_MASTER_KEY=""
# Cryptographic 256-bit random hex secret for HMAC-SHA256 admin session tokens
ADMIN_SESSION_SECRET=""
# Canonical public application URL for redirects and absolute links
NEXT_PUBLIC_APP_URL=""
